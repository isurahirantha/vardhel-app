// ============================================================================
// 6.5 Customer Proof (Feedback & FAQs)
// ============================================================================

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum FeedbackSource {
  PUBLIC_FORM
  ADMIN_ENTERED
}

model Feedback {
  id               String         @id @default(cuid())
  status           FeedbackStatus @default(PENDING)
  name             String         @db.VarChar(191)
  company          String?        @db.VarChar(191)
  role             String?        @db.VarChar(191)
  email            String?        @db.VarChar(255) // Private, NEVER returned to public
  rating           Int            @default(5)
  message          String         @db.Text
  messageSi        String?        @map("message_si") @db.Text
  photoMediaId     String?        @map("photo_media_id")
  relatedProjectId String?        @map("related_project_id")
  relatedProductId String?        @map("related_product_id")
  consentToPublish Boolean        @default(false) @map("consent_to_publish")
  source           FeedbackSource @default(PUBLIC_FORM)
  locale           String         @default("en") @db.VarChar(16)
  submittedIpHash  String?        @map("submitted_ip_hash") @db.VarChar(128)
  moderatedBy      String?        @map("moderated_by")
  moderatedAt      DateTime?      @map("moderated_at")
  isFeatured       Boolean        @default(false) @map("is_featured")
  displayOrder     Int            @default(0) @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  photo            Media?         @relation("FeedbackPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  project          Project?       @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  product          Product?       @relation(fields: [relatedProductId], references: [id], onDelete: SetNull)
  moderator        AdminUser?     @relation(fields: [moderatedBy], references: [id], onDelete: SetNull)

  @@index([status, displayOrder])
  @@index([createdAt])
  @@map("feedback")
}

model Faq {
  id          String    @id @default(cuid())
  group       String    @default("general") @db.VarChar(64)
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  translations FaqTranslation[]

  @@index([isPublished, sortOrder])
  @@map("faqs")
}

model FaqTranslation {
  id          String  @id @default(cuid())
  faqId       String  @map("faq_id")
  locale      String  @db.VarChar(16)
  question    String  @db.VarChar(255)
  answer      String  @db.Text
  needsReview Boolean @default(false) @map("needs_review")

  faq         Faq     @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
  @@map("faqs_translations")
}

// ============================================================================
// 6.6 Company Content (Team, Values, Timeline, Process, Offers, Stats, Pages)
// ============================================================================

model TeamMember {
  id          String    @id @default(cuid())
  photoId     String?   @map("photo_id")
  linksJson   Json?     @map("links_json")
  isRoleOnly  Boolean   @default(false) @map("is_role_only") // True for generic roles
  sortOrder   Int       @default(0) @map("sort_order")
  isVisible   Boolean   @default(true) @map("is_visible")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  photo        Media?                  @relation("TeamPhoto", fields: [photoId], references: [id], onDelete: SetNull)
