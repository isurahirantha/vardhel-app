// ============================================================================
// 6.7 Leads / Enquiries
// ============================================================================

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WON
  CLOSED
}

model Enquiry {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(191)
  email        String        @db.VarChar(255)
  phone        String?       @db.VarChar(64)
  businessName String?       @map("business_name") @db.VarChar(191)
  interest     String        @db.VarChar(128)
  budgetRange  String?       @map("budget_range") @db.VarChar(128)
  message      String        @db.Text
  status       EnquiryStatus @default(NEW)
  sourcePage   String?       @map("source_page") @db.VarChar(255)
  locale       String        @default("en") @db.VarChar(16)
  ipHash       String?       @map("ip_hash") @db.VarChar(128)
  userAgent    String?       @map("user_agent") @db.VarChar(512)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  notes        EnquiryNote[]

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("enquiries")
}

model EnquiryNote {
  id        String    @id @default(cuid())
  enquiryId String    @map("enquiry_id")
  adminId   String?   @map("admin_id")
  note      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  enquiry   Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@map("enquiry_notes")
}

model FormOption {
  id          String   @id @default(cuid())
  optionType  String   @map("option_type") @db.VarChar(64) // interest | budget_range
  valueKey    String   @map("value_key") @db.VarChar(64)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  translations FormOptionTranslation[]

  @@unique([optionType, valueKey])
  @@index([optionType, isActive, sortOrder])
  @@map("form_options")
}

model FormOptionTranslation {
  id          String     @id @default(cuid())
  optionId    String     @map("option_id")
  locale      String     @db.VarChar(16)
  label       String     @db.VarChar(191)
  needsReview Boolean    @default(false) @map("needs_review")

  option      FormOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
  @@map("form_options_translations")
}
